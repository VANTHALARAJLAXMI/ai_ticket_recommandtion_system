# Used only by the Supabase Edge Function runtime.
# Do not prefix these with VITE_ and do not import them in React.
# A hosted Edge Function cannot reach http://127.0.0.1 on your computer.
# Use a private Ollama URL that the function can reach, or serve functions locally.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=
ALLOWED_ORIGIN=http://localhost:5173
